{
  "name": "@overseek/minimatch-compat",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy callable exports backed by the patched upstream minimatch implementation",
  "type": "commonjs",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "minimatch-patched": "npm:minimatch@^11.0.3"
  }
}
