// SocialiseIT Database Schema
// Multi-tenant social media management platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: Prisma 7+ - connection URL is passed to PrismaClient constructor via driver adapter
  // See: src/lib/db.ts
}

// ============================================================================
// AUTHENTICATION & MULTI-TENANCY
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String? // For email/password auth (hashed)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Platform Administration
  isSuperAdmin Boolean   @default(false)
  bannedAt     DateTime? // Non-null = permabanned
  banReason    String?   // Why the user was banned

  // Two-Factor Authentication
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?  @db.Text // Encrypted TOTP secret
  backupCodes      String[] // Encrypted backup codes

  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
}

// Why: Prevents duplicate webhook processing if Stripe retries.
// TTL cleanup via a scheduled job or DB-level TTL index.
model ProcessedWebhookEvent {
  eventId     String   @id // Stripe event ID (evt_...)
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Device tracking for session management
  userAgent  String?
  ipAddress  String?
  deviceName String? // Derived from user agent parsing
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// ORGANIZATION (PRIMARY TENANT - Formerly Workspace)
// ============================================================================

model Organization {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  logo          String?
  tier          OrganizationTier @default(FREE)
  maxMembers    Int              @default(5)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Stripe Billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?   // "active", "past_due", "canceled", "trialing"
  currentPeriodEnd     DateTime? // When the current billing period ends
  cancelAtPeriodEnd    Boolean   @default(false)

  // Settings (moved from Workspace)
  timezone       String  @default("UTC")
  accentColor    String  @default("#D4A574") // User-customizable
  accentColorAlt String  @default("#E8B4B8")
  darkMode       Boolean @default(false)

  // AI Features
  aiDraftsEnabled Boolean @default(true) // Generate AI draft posts for optimal times

  // Members
  members OrganizationMember[]

  // All relations (consolidated from Workspace)
  socialAccounts       SocialAccount[]
  posts                Post[]
  media                Media[]
  mediaFolders         MediaFolder[]
  contentPillars       ContentPillar[]
  brandVoice           BrandVoice?
  productCatalog       ProductCatalog?
  shopConnections      ShopConnection[]
  activities           Activity[]
  automations          Automation[]
  competitors          Competitor[]

  // Engagement & Analytics
  comments             Comment[]
  mentions             Mention[]
  directMessages       DirectMessage[]
  reviews              Review[]
  inboxLabels          InboxLabel[]
  savedResponses       SavedResponse[]
  platformAnalytics    PlatformAnalytics[]
  dailySnapshots       DailyAnalyticsSnapshot[]
  // Content Management
  captionTemplates     CaptionTemplate[]
  // RBAC - Custom Roles
  customRoles          CustomRole[]
  // UTM & Reports
  utmTemplates         UtmTemplate[]
  scheduledReports     ScheduledReport[]
  // Smart Scheduling (Phase 2)
  contentTimingPatterns  ContentTimingPattern[]
  hashtagTimingPatterns  HashtagTimingPattern[]
  // Hashtag Management
  hashtagCollections     HashtagCollection[]
  // ML/Learning (Phase 4)
  draftInteractions      DraftInteraction[]
  engagementPredictions  EngagementPrediction[]
  // Audio Library
  audioTracks            AudioTrack[]
  // Calendar Notes
  calendarNotes          CalendarNote[]
  // Push Notification Devices (org-level registry)
  notificationDevices    NotificationDevice[]

  // In-App Notifications
  notifications          Notification[]

  @@index([tier])
}

enum OrganizationTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
  ADMIN // Hidden tier: $0 internal use, assigned only by Super Admins
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  customRoleId   String?  // Optional custom role for granular permissions
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([customRoleId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  CUSTOM // Use customRoleId for granular permissions
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?      // Optional: If null, applies to the whole organization
  title          String
  message        String
  type           String       // 'alert', 'info', 'success', 'warning'
  link           String?      // Optional URL to navigate to when clicked
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================================
// ADMIN AUDIT LOG
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g., "user.promote_admin", "org.delete", "impersonate.start"
  actorId   String   // Super admin who performed the action
  targetId  String?  // ID of affected entity (user, org)
  targetType String? // Type of target: "user", "organization"
  metadata  Json?    // Additional context (old values, new values, etc.)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM SETTINGS (Singleton)
// ============================================================================

model PlatformSettings {
  id                    String   @id @default("platform_settings")
  registrationEnabled   Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?
  maxOrganizationsPerUser  Int      @default(5)
  maxMembersPerOrganization Int     @default(20)
  rateLimitRequestsPerMinute Int @default(100)
  // TikTok Discovery API access token (encrypted via lib/crypto.ts)
  // Why: Stored here so super admins can configure via admin UI instead of env vars
  tiktokDiscoveryToken  String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================================================
// PLAN CONFIGURATION (Super Admin — editable tier limits & display)
// Why: Lets super admins tune plan limits and pricing display at runtime
// without code deployments. One row per tier.
// ============================================================================

model PlanConfig {
  tier                    String   @id // "FREE", "PRO", "BUSINESS", "ENTERPRISE"

  // Display metadata
  displayName             String   @default("")
  description             String   @default("")
  color                   String   @default("#6B7280")

  // Pricing (for frontend display only — Stripe is source of truth for billing)
  priceMonthly            Int      @default(0)     // cents
  pricingLabel            String   @default("$0")  // e.g. "$29", "Custom"
  pricingPeriod           String   @default("/mo")
  popular                 Boolean  @default(false)
  ctaText                 String   @default("Get Started")

  // Numerical limits (-1 = unlimited)
  socialAccounts          Int      @default(3)
  teamMembers             Int      @default(2)
  scheduledPostsPerMonth  Int      @default(30)
  aiGenerationsPerMonth   Int      @default(10)
  competitorTracking      Int      @default(0)

  // Boolean feature flags
  videoEditor             Boolean  @default(false)
  analyticsExport         Boolean  @default(false)
  customBranding          Boolean  @default(false)
  prioritySupport         Boolean  @default(false)

  // Feature bullet points for pricing cards
  featureBullets          String[] @default([])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ============================================================================
// GLOBAL PLATFORM CREDENTIALS (Super Admin - Shared OAuth App Config)
// ============================================================================

model GlobalPlatformCredential {
  id                 String   @id @default(cuid())
  platform           Platform @unique
  clientId           String   @db.Text
  clientSecret       String   @db.Text // Encrypted
  webhookVerifyToken String?  @db.Text // Auto-generated for webhook verification
  isConfigured       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================================
// GLOBAL AI SETTINGS (Super Admin - OpenRouter Configuration)
// ============================================================================

model GlobalAISettings {
  id             String   @id @default("global_ai_settings")
  apiKey         String   @db.Text // Encrypted OpenRouter API key
  selectedModel  String? // Model ID e.g., "openai/gpt-4o"
  modelName      String? // Display name for UI
  isConfigured   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// GLOBAL INTEGRATION SETTINGS (Super Admin - Third-Party APIs)
// Why: Stores Stripe API config and other third-party integration settings.
// Secrets are encrypted at the application layer via lib/crypto.ts.
// ============================================================================

model GlobalIntegrationSettings {
  id            String   @id @default("global_integration_settings")

  // Stripe API keys (encrypted via AES-256-GCM before storage)
  stripeSecretKey      String?  @db.Text
  stripePublishableKey String?
  stripeWebhookSecret  String?  @db.Text

  // Stripe price IDs (not secrets — stored plaintext)
  stripeProPriceId         String?
  stripeBusinessPriceId    String?
  stripeEnterprisePriceId  String?

  // Stripe checkout config
  stripeTrialDays      Int      @default(0)
  stripeConfigured     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}



// ============================================================================
// GRANULAR PERMISSIONS (RBAC)
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "posts.publish", "analytics.export"
  name        String           // Human-readable name
  category    String           // Grouping: "posts", "analytics", "team", etc.
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([category])
}

model CustomRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id           String @id @default(cuid())
  customRoleId String
  permissionId String

  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionId])
}


// ============================================================================
// SOCIAL ACCOUNTS
// ============================================================================

model SocialAccount {
  id             String    @id @default(cuid())
  organizationId String
  platform       Platform
  platformId     String // Platform's user/page ID
  name           String
  username       String?
  customPlatformName String?  // User-defined platform name (only for MANUAL accounts, e.g. "Lemon8")
  avatar         String?
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiry    DateTime?
  isActive       Boolean   @default(true)
  lastRefreshAt    DateTime? // When the token was last proactively refreshed
  lastRefreshError String?   // Last refresh failure message for diagnostics
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  directPosts    Post[]              // NEW: Independent posts per platform
  // Engagement & Analytics
  comments       Comment[]
  mentions       Mention[]
  directMessages DirectMessage[]
  reviews        Review[]
  analytics      PlatformAnalytics[]
  // Pinterest Board Cache
  pinterestBoardCache PinterestBoardCache?
  // Audience Activity (follower-online data for smart scheduling)
  audienceActivity    AudienceActivity?

  @@unique([organizationId, platform, platformId])
  @@index([organizationId])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  META
  TIKTOK
  YOUTUBE
  PINTEREST
  GOOGLE_BUSINESS
  LINKEDIN
  BLUESKY
  THREADS
  MANUAL
}

// ============================================================================
// PINTEREST BOARD CACHE
// ============================================================================

model PinterestBoardCache {
  id              String   @id @default(cuid())
  socialAccountId String   @unique
  boards          Json     // Array of PinterestBoard objects
  cachedAt        DateTime @default(now())
  expiresAt       DateTime // Cache expiry time (24 hours from cachedAt)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum PostType {
  FEED // Standard feed post (all platforms)
  REEL // Instagram Reels, TikTok, YouTube Shorts
  STORY // Instagram/Facebook Stories
  CAROUSEL // Multi-image posts (Instagram, LinkedIn, TikTok)
  PIN // Pinterest pins
  VIDEO // Long-form video (YouTube, LinkedIn)
  ARTICLE // LinkedIn articles
  THREAD // Bluesky threads
}

// ============================================================================
// CONTENT
// ============================================================================

model Post {
  id             String     @id @default(cuid())
  organizationId String
  caption        String     @db.Text
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  autoPublish    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // First Comment (Instagram engagement hack)
  firstComment String? @db.Text

  // AI & Analytics
  isAiGenerated   Boolean @default(false) // True if created by AI scheduling
  viralityScore   Float?
  brandVoiceScore Float?

  // External post tracking (synced from platforms)
  isExternal  Boolean   @default(false) // True if synced from platform
  externalId  String?                    // Platform's media/post ID
  externalUrl String?                    // Permalink on platform
  externalThumbnailUrl String?           // Thumbnail URL from platform (for external posts only)
  syncedAt    DateTime?                  // When this was last synced

  // ============================================================================
  // NEW: Per-platform fields (for independent posts architecture)
  // Why: Each post now targets exactly one platform. Multi-platform posts are
  // created as separate Post records linked via linkedGroupId.
  // ============================================================================
  platform        Platform?  // Optional: NULL for legacy posts created before PostPlatform migration
  socialAccountId String?    // Which account to publish to (null for legacy posts)
  postType        PostType   @default(FEED) // Post type for this platform
  platformPostId  String?    // ID returned after publishing
  callToAction    String?    // CTA button type (learn_more, shop_now, etc.)
  // Pinterest-specific fields
  pinTitle        String?    @db.VarChar(100) // Pin title (max 100 chars)
  pinLink         String?    // Destination URL for the pin
  boardId         String?    // Pinterest board ID
  // YouTube-specific fields
  videoTitle        String?   @db.VarChar(100)  // Required for YouTube uploads (max 100 chars)
  youtubeCategory   String?                      // Category ID (e.g., "22" = People & Blogs)
  youtubePlaylist   String?                      // Playlist ID to add video to after upload
  videoTags         String[]                     // Video tags for discovery
  createFirstLike   Boolean   @default(false)    // Like video after upload
  embeddable        Boolean   @default(true)     // Allow video embedding
  notifySubscribers Boolean   @default(true)     // Notify subscribers on publish
  madeForKids       Boolean   @default(false)    // COPPA compliance flag
  youtubePrivacy    String?                      // Privacy status: public, private, unlisted
  // Why (BUG-36): Previously the composer sent youtubeCommentsEnabled but it was
  // never stored — YouTube publishes always enabled comments regardless of toggle.
  youtubeCommentsEnabled Boolean @default(true)  // Enable comments on YouTube video
  // LinkedIn-specific fields
  // Why (BUG-37): Previously linkedinVisibility was sent from the composer but
  // never persisted — LinkedIn posts were always published as PUBLIC.
  linkedinVisibility String?                      // Visibility: PUBLIC or CONNECTIONS
  // TikTok-specific fields
  tiktokPrivacyLevel String?                      // Privacy level: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR, SELF_ONLY
  tiktokContentDisclosure Boolean @default(false)   // Master toggle for branded content
  tiktokBrandOrganic Boolean   @default(false)    // Promotional content (own business)
  tiktokBrandContent Boolean   @default(false)    // Paid partnership
  tiktokIsAigc       Boolean   @default(false)    // AI generated content
  tiktokComments     Boolean   @default(true)     // Allow comments
  tiktokDuets        Boolean   @default(true)     // Allow duets
  tiktokStitches     Boolean   @default(true)     // Allow stitches
  // Instagram-specific fields
  instagramShareToFeed Boolean   @default(true)     // Share Reel to feed
  instagramComments    Boolean   @default(true)     // Enable comments
  isTrialReel          Boolean   @default(false)    // Trial Reel: shown to non-followers first
  // Location tagging
  location        String?    // Location ID for geo-tagging (Instagram, TikTok, Facebook)
  customMediaIds  String[]   // Platform-specific media override
  linkedGroupId   String?    // Optional: Links posts created together for multi-platform scheduling
  notifyDeviceIds String[]   // Array of NotificationDevice IDs to notify when autoPublish is false

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  pillarId      String?
  pillar        ContentPillar? @relation(fields: [pillarId], references: [id])

  media         PostMedia[]
  hashtags      PostHashtag[]
  products      PostProduct[]
  errors        PublishError[]
  analytics     PostAnalytics? // NEW: Direct analytics relation
  productTags   ProductTag[]   // NEW: Direct product tags relation
  // Collaboration
  postComments      PostComment[]
  // Engagement
  comments          Comment[]
  // ML/Learning (Phase 4)  
  draftInteractions DraftInteraction[]

  @@unique([organizationId, externalId]) // Prevent duplicate imports
  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, publishedAt]) // Analytics + Calendar queries filter by publishedAt
  @@index([organizationId, status, scheduledAt]) // Calendar multi-status range queries
  @@index([linkedGroupId]) // For finding related multi-platform posts
  @@index([socialAccountId]) // For filtering by account
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// PostPlatform model REMOVED — migrated to direct Post fields (Phase 4)

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  mediaId String
  order   Int    @default(0)
  // User-selected custom thumbnail (frame pick or upload)
  customThumbnailUrl String?

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id])

  @@unique([postId, mediaId])
}

model PostHashtag {
  id        String @id @default(cuid())
  postId    String
  hashtagId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
}

model PostProduct {
  id        String @id @default(cuid())
  postId    String
  productId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([postId, productId])
}

// ============================================================================
// MEDIA LIBRARY
// ============================================================================

model Media {
  id             String   @id @default(cuid())
  organizationId String
  folderId       String?
  filename       String
  mimeType       String
  size           Int // bytes
  width          Int?
  height         Int?
  duration       Float? // seconds for video
  url            String
  thumbnailUrl   String?
  transcodedUrl    String?   // Why: H.264 transcoded version URL (videos only), set at upload-time
  transcodeStatus  String?   // Why: null = no transcode needed/legacy, 'pending' | 'processing' | 'completed' | 'failed'
  altText        String?
  tags           String[]
  aiTags         String[] // Auto-generated
  // Duplicate detection & grouping
  contentHash    String?   // Perceptual hash for dedup (images only, 16-char hex)
  sourceMediaId  String?   // Links resized/variant copies to their original
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  posts        PostMedia[]
  sourceMedia  Media?       @relation("MediaVariants", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  variants     Media[]      @relation("MediaVariants")

  @@index([organizationId, createdAt])
  @@index([organizationId, contentHash])
  @@index([sourceMediaId])
  @@index([folderId])
}

model MediaFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        Media[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// AUDIO LIBRARY (Sound Overlay Feature)
// ============================================================================

model AudioTrack {
  id             String   @id @default(cuid())
  organizationId String?  // null = system-wide featured track
  name           String
  url            String
  duration       Float    // seconds
  waveformData   String?  @db.Text // JSON array of amplitude values for visualization
  isFeatured     Boolean  @default(false) // Royalty-free featured tracks
  category       String?  // e.g., "upbeat", "chill", "dramatic"
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isFeatured])
}

// ============================================================================
// CONTENT ORGANIZATION
// ============================================================================

model ContentPillar {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#D4A574")
  icon           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        Post[]

  @@unique([organizationId, name])
}

model CaptionTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  caption        String   @db.Text
  hashtags       String[] // Pre-extracted hashtags for quick display
  category       String?  // e.g., "Promotional", "Educational", "CTA"
  usageCount     Int      @default(0)
  // Enhanced template features
  thumbnailUrl String?  // Template preview image
  mediaIds     String[] // Reference to Media items
  platforms    Platform[] // Recommended platforms for this template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Hashtag {
  id         String  @id @default(cuid())
  tag        String  @unique
  isBanned   Boolean @default(false)
  usageCount Int     @default(0)

  posts PostHashtag[]
}

// Saved hashtag collections (groups of hashtags for quick insertion)
model HashtagCollection {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  hashtags       String[] // Array of hashtag strings (without # prefix)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// AI & BRAND VOICE
// ============================================================================

model BrandVoice {
  id             String   @id @default(cuid())
  organizationId String   @unique
  samples        String[] // Past content for training
  toneProfile    Json? // AI-extracted patterns
  guidelines     String?  @db.Text // Brand guide
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// COMMERCE & ATTRIBUTION
// ============================================================================

// Platform Commerce/Shop Connection (for product tagging)
model ShopConnection {
  id             String         @id @default(cuid())
  organizationId String
  platform       Platform
  catalogId      String // Platform's catalog/shop ID
  name           String // Shop display name
  isActive       Boolean        @default(true)
  syncStatus     ShopSyncStatus @default(PENDING)
  lastSyncAt     DateTime?
  lastSyncError  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
  @@index([organizationId])
}

enum ShopSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

// Product tag on a specific post/media (for shoppable posts)
model ProductTag {
  id                String   @id @default(cuid())
  postId            String
  productId         String? // Link to internal product (optional)
  platformProductId String // Product ID in platform's catalog (required)
  productName       String // Denormalized for display
  productPrice      Float?
  productCurrency   String?
  productImageUrl   String?
  mediaIndex        Int      @default(0) // Which media item (for carousels)
  positionX         Float? // 0-1 percentage from left (null for non-visual tags)
  positionY         Float? // 0-1 percentage from top
  createdAt         DateTime @default(now())

  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([postId])
  @@index([productId])
}

model ProductCatalog {
  id             String        @id @default(cuid())
  organizationId String        @unique
  source         CatalogSource
  externalId     String? // Shopify store ID, etc.
  syncedAt       DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
}

enum CatalogSource {
  SHOPIFY
  WOOCOMMERCE
  MANUAL
}

model Product {
  id          String   @id @default(cuid())
  catalogId   String
  externalId  String // Product ID from source
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  productUrl  String?
  isActive    Boolean  @default(true)
  syncedAt    DateTime @default(now())

  // Platform-specific product IDs for shopping features
  instagramProductId String? // Meta Commerce product ID
  facebookProductId  String? // Meta Commerce product ID (often same as IG)
  pinterestProductId String? // Pinterest catalog product ID
  tiktokProductId    String? // TikTok Shop product ID
  youtubeProductId   String? // YouTube Shopping product ID

  catalog     ProductCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  posts       PostProduct[]
  productTags ProductTag[]

  @@unique([catalogId, externalId])
}

// ============================================================================
// ERROR LOGGING
// ============================================================================

model PublishError {
  id         String   @id @default(cuid())
  postId     String
  platform   Platform
  errorCode  String
  errorRaw   String   @db.Text
  errorHuman String
  suggestion String?
  occurredAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ============================================================================
// ACTIVITY LOG
// ============================================================================

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  userName       String? // Denormalized for display
  action         String // published, scheduled, uploaded, connected, deleted, invited, etc.
  resourceType   String // post, media, account, automation, team, pillar
  resourceId     String?
  resourceName   String
  details        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================================================
// AUTOMATIONS
// ============================================================================

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trigger        String // keyword, new_follower, story_mention, comment
  platform       Platform
  message        String   @db.Text
  isActive       Boolean  @default(true)
  triggered      Int      @default(0)
  delivered      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// COMPETITOR TRACKING
// ============================================================================

model Competitor {
  id             String    @id @default(cuid())
  organizationId String
  platform       Platform
  username       String
  displayName    String?
  avatar         String?
  followers      Int       @default(0)
  followerGrowth Float     @default(0)
  avgEngagement  Float     @default(0)
  postsPerWeek   Float     @default(0)
  isVerified     Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  // Competitor Benchmarking (Phase 3)
  engagementHistory Json?   // { date: string, engagement: number }[]
  shareOfVoice      Float   @default(0) // Calculated percentage vs your brand
  benchmarkScore    Int     @default(0) // 0-100 competitive score

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        CompetitorPost[] // For timing analysis

  @@unique([organizationId, platform, username])
  @@index([organizationId])
}

// ============================================================================
// WEB PUSH NOTIFICATIONS
// ============================================================================

// Why: Singleton — one VAPID key pair for the entire platform,
// generated and managed by super admins only.
model VapidKeyPair {
  id         String   @id @default("vapid_keys")
  publicKey  String   @db.Text
  privateKey String   @db.Text // Encrypted via lib/crypto.ts
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  endpoint       String   @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  userAgent      String?
  createdAt      DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationDevice NotificationDevice?

  @@unique([userId, endpoint])
  @@index([organizationId])
}

model NotificationDevice {
  id                 String   @id @default(cuid())
  organizationId     String
  label              String   // User-friendly name e.g. "Sam's iPhone"
  pushSubscriptionId String?  @unique  // Linked subscription (optional until paired)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, label])
  @@index([organizationId])
}

model NotificationSettings {
  id             String  @id @default(cuid())
  organizationId String
  userId         String
  postPublished      Boolean @default(true)
  postFailed         Boolean @default(true)
  postReadyToPublish Boolean @default(true)
  tokenExpiring      Boolean @default(true)
  weeklyDigest       Boolean @default(false)
  newComment         Boolean @default(true)
  newDM              Boolean @default(true)
  newMention         Boolean @default(true)
  newReview          Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================================
// ENGAGEMENT: COMMENTS
// ============================================================================

model Comment {
  id                String   @id @default(cuid())
  organizationId    String
  socialAccountId   String
  postId            String? // Link to our published post (if we published it)
  platformPostId    String // Platform's post ID
  platformCommentId String // Platform's comment ID
  authorId          String // Comment author's platform ID
  authorUsername    String
  authorAvatar      String?
  text              String   @db.Text
  sentiment         String? // positive, neutral, negative, question
  isReplied         Boolean  @default(false)
  isHidden          Boolean  @default(false)
  isRead            Boolean  @default(false)
  assignedToId      String?  // Team member assignment
  labelIds          String[] // Array of InboxLabel IDs
  parentId          String? // For reply threads
  likeCount         Int      @default(0)
  replyCount        Int      @default(0)
  createdAt         DateTime // When comment was created on platform
  syncedAt          DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  post          Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Comment[]     @relation("CommentReplies")

  @@unique([socialAccountId, platformCommentId])
  @@index([organizationId, createdAt])
  @@index([organizationId, isRead, createdAt]) // Inbox unread filtering with date sort
  @@index([socialAccountId])
  @@index([postId])
}

// ============================================================================
// ENGAGEMENT: REVIEWS (Google Business & Facebook)
// ============================================================================

model Review {
  id                String   @id @default(cuid())
  organizationId    String
  socialAccountId   String
  platformReviewId  String   // Platform's review ID
  authorName        String   // Reviewer's display name
  authorAvatar      String?  // Reviewer's profile image
  rating            Int      // 1-5 stars (Google uses STAR_RATING enum, mapped to int)
  text              String?  @db.Text // Review body (can be empty for rating-only)
  replyText         String?  @db.Text // Our reply text (stored locally after posting)
  isReplied         Boolean  @default(false)
  isRead            Boolean  @default(false)
  platform          Platform // GOOGLE_BUSINESS or FACEBOOK
  reviewUrl         String?  // Link to the review on the platform
  createdAt         DateTime // When review was posted
  syncedAt          DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformReviewId])
  @@index([organizationId, createdAt])
  @@index([socialAccountId])
}

// ============================================================================
// ENGAGEMENT: MENTIONS & TAGS
// ============================================================================

model Mention {
  id              String   @id @default(cuid())
  organizationId  String
  socialAccountId String
  type            String // mention, tag, story_mention, story_reply
  platformPostId  String // The post/story where mention occurred
  authorId        String // Who mentioned us
  authorUsername  String
  authorAvatar    String?
  text            String?  @db.Text // Caption/comment text if available
  mediaUrl        String? // Media thumbnail/URL if available
  isRead          Boolean  @default(false)
  assignedToId    String?  // Team member assignment
  labelIds        String[] // Array of InboxLabel IDs
  createdAt       DateTime // When mention occurred
  syncedAt        DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId, type])
  @@index([organizationId, isRead])
  @@index([organizationId, isRead, createdAt]) // Inbox unread filtering with date sort
  @@index([socialAccountId])
}

// ============================================================================
// ENGAGEMENT: DIRECT MESSAGES
// ============================================================================

model DirectMessage {
  id                String   @id @default(cuid())
  organizationId    String
  socialAccountId   String
  conversationId    String   // Platform's conversation/thread ID
  platformMessageId String   // Platform's message ID
  direction         String   // "inbound" | "outbound"
  senderId          String   // Platform user ID
  senderUsername    String
  senderAvatar      String?
  text              String?  @db.Text
  mediaUrl          String?  // Attached media
  mediaType         String?  // image, video, audio, sticker
  isRead            Boolean  @default(false)
  assignedToId      String?  // Team member assignment
  labelIds          String[] // Array of InboxLabel IDs
  createdAt         DateTime // When message was sent on platform
  syncedAt          DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformMessageId])
  @@index([organizationId, createdAt])
  @@index([socialAccountId, conversationId])
  @@index([conversationId])
}

// ============================================================================
// INBOX: LABELS FOR ORGANIZATION
// ============================================================================

model InboxLabel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// INBOX: SAVED RESPONSES (CANNED REPLIES)
// ============================================================================

model SavedResponse {
  id             String    @id @default(cuid())
  organizationId String
  name           String    // Short identifier e.g. "thanks"
  content        String    @db.Text // The reply text
  shortcut       String?   // Keyboard shortcut e.g. "/thanks"
  category       String?   // e.g. "Support", "Sales", "Follow-up"
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

// ============================================================================
// ANALYTICS: PLATFORM-LEVEL METRICS
// ============================================================================

model PlatformAnalytics {
  id              String   @id @default(cuid())
  organizationId  String
  socialAccountId String
  date            DateTime @db.Date // Day of metrics snapshot
  followers       Int      @default(0)
  followersChange Int      @default(0) // Change from previous day
  following       Int      @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  engagementRate  Float    @default(0) // Percentage
  profileViews    Int      @default(0)
  websiteClicks   Int      @default(0)
  emailClicks     Int      @default(0)
  // Platform-specific metrics stored as JSON
  platformMetrics Json? // { audienceDemographics, topCities, etc. }
  syncedAt        DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@index([organizationId, date])
  @@index([socialAccountId, date])
}

// ============================================================================
// ANALYTICS: POST-LEVEL METRICS
// ============================================================================

model PostAnalytics {
  id                 String   @id @default(cuid())
  postId             String?  @unique  // Optional: NULL for orphaned analytics rows
  impressions        Int      @default(0)
  reach              Int      @default(0)
  likes              Int      @default(0)
  comments           Int      @default(0)
  shares             Int      @default(0)
  saves              Int      @default(0)
  clicks             Int      @default(0)
  videoViews         Int? // For video content
  videoWatchTime     Float? // Seconds of watch time
  avgWatchPercentage Float? // Average % of video watched
  engagementRate     Float    @default(0)
  // Platform-specific breakdown
  platformMetrics    Json? // { reachBySource, impressionsByLocation, etc. }
  syncedAt           DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ============================================================================
// ANALYTICS: DAILY AGGREGATE SNAPSHOTS
// ============================================================================

/// Why: Platform APIs give per-post and per-account snapshots. This table
/// stores pre-computed daily totals so the analytics page reads fast,
/// pre-aggregated data instead of summing PostAnalytics at query time.
model DailyAnalyticsSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  platform        Platform
  date            DateTime @db.Date
  // Engagement totals (summed from PostAnalytics for the day)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  clicks          Int      @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  videoViews      Int      @default(0)
  // Account-level (latest from PlatformAnalytics for the day)
  followers       Int      @default(0)
  followersChange Int      @default(0)
  // Computed
  engagementRate  Float    @default(0)
  postsPublished  Int      @default(0)
  // Metadata
  syncedAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, date])
  @@index([organizationId, date])
}

// ============================================================================
// UTM TEMPLATES (Composer Enhancement)
// ============================================================================

model UtmTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  source         String   // e.g., "instagram", "facebook"
  medium         String   // e.g., "social", "email"
  campaign       String?  // e.g., "spring_sale"
  content        String?  // e.g., "hero_image"
  term           String?  // e.g., "shoes"
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// SCHEDULED REPORTS (Analytics)
// ============================================================================

model ScheduledReport {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  schedule       String   // Cron expression e.g., "0 9 * * 1" (Mon 9am)
  recipients     String[] // Email addresses
  config         Json     // ReportConfig { type, dateRange, metrics, etc. }
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isActive       Boolean  @default(true)
  // Flexible delivery options (Phase 2)
  deliveryFormat String   @default("pdf")  // "pdf", "link", "both"
  shareToken     String?  @unique          // UUID for public live-link access
  lastReportData Json?                     // Cached report snapshot for live view
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([nextRunAt])
}

// ============================================================================
// POST COMMENTS (Collaboration)
// ============================================================================

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies PostCommentReply[]

  @@index([postId])
  @@index([userId])
}

model PostCommentReply {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// ============================================================================
// SMART SCHEDULING (Phase 2 Analytics)
// ============================================================================

/// Learned content timing patterns by content attributes
model ContentTimingPattern {
  id               String   @id @default(cuid())
  organizationId   String
  platform         Platform
  /// Content signature: "short_image_feed", "long_video_reel", etc.
  contentSignature String
  bestDay          Int      // 0-6 (Sunday-Saturday)  
  bestHour         Int      // 0-23
  avgEngagement    Float    @default(0)
  sampleSize       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, contentSignature])
  @@index([organizationId])
}

/// Hashtag performance by time slot
model HashtagTimingPattern {
  id             String   @id @default(cuid())
  organizationId String
  platform       Platform
  hashtag        String   // Normalized lowercase hashtag
  bestDay        Int      // 0-6
  bestHour       Int      // 0-23
  avgEngagement  Float    @default(0)
  sampleSize     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, hashtag])
  @@index([organizationId])
}
// ============================================================================
// COMPETITOR POST TRACKING (Phase 3)
// ============================================================================

/// Tracked competitor posts for timing analysis
model CompetitorPost {
  id           String   @id @default(cuid())
  competitorId String
  platformId   String?  // Post ID from the platform
  postedAt     DateTime
  caption      String?  @db.Text
  mediaType    String?  // image, video, carousel
  engagement   Int      @default(0) // Total engagement (likes + comments)
  likes        Int      @default(0)
  comments     Int      @default(0)
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, platformId])
  @@index([competitorId])
  @@index([postedAt])
}

// ============================================================================
// ML/LEARNING (Phase 4)
// ============================================================================

/// Tracks user interactions with AI-generated drafts for learning
model DraftInteraction {
  id             String          @id @default(cuid())
  organizationId String
  postId         String?         // If draft was converted to a post
  action         DraftAction
  platform       Platform
  postType       PostType        @default(FEED)
  suggestedDay   Int             // 0-6 (original suggestion)
  suggestedHour  Int             // 0-23 (original suggestion)
  finalDay       Int?            // If modified, the final day chosen
  finalHour      Int?            // If modified, the final hour chosen
  reason         String?         // Optional user feedback
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
  @@index([platform, postType])
}

enum DraftAction {
  ACCEPTED   // User accepted the AI draft as-is
  MODIFIED   // User accepted but changed the time
  DISMISSED  // User dismissed the draft
  EXPIRED    // Draft time passed without action
}

/// Stores learned engagement predictions per time slot
model EngagementPrediction {
  id              String   @id @default(cuid())
  organizationId  String
  platform        Platform
  postType        PostType @default(FEED)
  day             Int      // 0-6
  hour            Int      // 0-23
  predictedScore  Float    @default(0) // 0-100 predicted engagement score
  confidence      Float    @default(0) // 0-1 confidence in prediction
  sampleSize      Int      @default(0)
  lastUpdated     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, postType, day, hour])
  @@index([organizationId])
}

// ============================================================================
// CALENDAR NOTES
// Why: Color-coded notes on calendar days for team communication and
// tracking events, milestones, and deadlines alongside scheduled posts.
// ============================================================================

model CalendarNote {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String   // User who created the note
  title          String
  description    String?  @db.Text
  date           DateTime // Which calendar day this note appears on
  color          String   @default("#D4A574") // Gradient/color code
  isPrivate      Boolean  @default(false) // Private = only visible to creator
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([createdById])
}

// ============================================================================
// AUDIENCE ACTIVITY (Follower Online Hours)
// Why: Caches per-account follower activity data fetched from platform APIs.
// Currently only Instagram exposes this via `online_followers`.
// Data is a 7×24 grid: day (0=Sun–6=Sat) → hour (0–23) → avg follower count.
// Refreshed daily during analytics sync.
// ============================================================================

model AudienceActivity {
  id              String   @id @default(cuid())
  socialAccountId String   @unique
  platform        Platform
  // Why: JSON grid avoids 168 rows (7 days × 24 hours) per account.
  // Shape: { "0": { "0": 120, "1": 95, ... "23": 200 }, "1": { ... } }
  activityGrid    Json
  fetchedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}
