// SocialiseIT Database Schema
// Multi-tenant social media management platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: Prisma 7+ - connection URL is passed to PrismaClient constructor via driver adapter
  // See: src/lib/db.ts
}

// ============================================================================
// AUTHENTICATION & MULTI-TENANCY
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String? // For email/password auth (hashed)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Platform Administration
  isSuperAdmin Boolean @default(false)

  // Two-Factor Authentication
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?  @db.Text // Encrypted TOTP secret
  backupCodes      String[] // Encrypted backup codes

  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  pushSubscriptions       PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Device tracking for session management
  userAgent  String?
  ipAddress  String?
  deviceName String? // Derived from user agent parsing
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// ORGANIZATION (PRIMARY TENANT - Formerly Workspace)
// ============================================================================

model Organization {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  logo          String?
  tier          OrganizationTier @default(FREE)
  maxMembers    Int              @default(5)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Settings (moved from Workspace)
  timezone       String  @default("UTC")
  accentColor    String  @default("#D4A574") // User-customizable
  accentColorAlt String  @default("#E8B4B8")
  darkMode       Boolean @default(false)

  // AI Features
  aiDraftsEnabled Boolean @default(true) // Generate AI draft posts for optimal times

  // Members
  members OrganizationMember[]

  // All relations (consolidated from Workspace)
  socialAccounts       SocialAccount[]
  platformCredentials  PlatformCredential[]
  aiSettings           AISettings?
  integrationSettings  IntegrationSettings?
  posts                Post[]
  media                Media[]
  mediaFolders         MediaFolder[]
  contentPillars       ContentPillar[]
  brandVoice           BrandVoice?
  productCatalog       ProductCatalog?
  shopConnections      ShopConnection[]
  activities           Activity[]
  automations          Automation[]
  competitors          Competitor[]
  vapidKeyPair         VapidKeyPair?
  // Engagement & Analytics
  comments             Comment[]
  mentions             Mention[]
  platformAnalytics    PlatformAnalytics[]
  // Content Management
  captionTemplates     CaptionTemplate[]
  // Video Editor
  videoProjects        VideoProject[]
  videoTemplates       VideoTemplate[]
  // RBAC - Custom Roles
  customRoles          CustomRole[]
  // UTM & Reports
  utmTemplates         UtmTemplate[]
  scheduledReports     ScheduledReport[]
  // Smart Scheduling (Phase 2)
  contentTimingPatterns  ContentTimingPattern[]
  hashtagTimingPatterns  HashtagTimingPattern[]
  // Hashtag Management
  hashtagCollections     HashtagCollection[]
  // ML/Learning (Phase 4)
  draftInteractions      DraftInteraction[]
  engagementPredictions  EngagementPrediction[]

  @@index([tier])
}

enum OrganizationTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  customRoleId   String?  // Optional custom role for granular permissions
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([customRoleId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  CUSTOM // Use customRoleId for granular permissions
}

// ============================================================================
// ADMIN AUDIT LOG
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g., "user.promote_admin", "org.delete", "impersonate.start"
  actorId   String   // Super admin who performed the action
  targetId  String?  // ID of affected entity (user, org)
  targetType String? // Type of target: "user", "organization"
  metadata  Json?    // Additional context (old values, new values, etc.)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM SETTINGS (Singleton)
// ============================================================================

model PlatformSettings {
  id                    String   @id @default("platform_settings")
  registrationEnabled   Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String?
  maxOrganizationsPerUser  Int      @default(5)
  maxMembersPerOrganization Int     @default(20)
  rateLimitRequestsPerMinute Int @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================================================
// VIDEO EDITOR
// ============================================================================

model VideoProject {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  aspectRatio    String   @default("LANDSCAPE") // LANDSCAPE, PORTRAIT, SQUARE, STORY
  fps            Int      @default(30)

  // Project state (JSON-serialized timeline data)
  clips        Json? // Clip[] - video/image clips
  textOverlays Json? // TextOverlay[] - text layers
  audioClips   Json? // AudioClip[] - audio tracks

  // AI-generated data (cached for performance)
  transcription Json? // Cached Whisper transcription
  audioAnalysis Json? // Silence gaps, beats, waveform
  sceneMarkers  Json? // Detected scene changes

  // Highlight Extraction (AI Best Moments)
  highlights      Json?            // HighlightClip[] - AI-detected best moments
  highlightStatus HighlightStatus  @default(PENDING)

  // Metadata
  thumbnailUrl String?
  duration     Float? // Total duration in seconds
  status       VideoProjectStatus @default(DRAFT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  captions     VideoCaption[]

  @@index([organizationId, updatedAt])
}

enum HighlightStatus {
  PENDING
  ANALYZING
  READY
  FAILED
}

enum VideoProjectStatus {
  DRAFT
  RENDERING
  RENDERED
  PUBLISHED
}


model VideoTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  category       String   @default("general") // social, tutorial, promo, intro, outro
  aspectRatio    String   @default("LANDSCAPE")
  durationSec    Float    @default(10)

  // Template structure
  config      Json // TemplateSection[], transitions, music config
  thumbnailUrl String?

  // Flags
  isBuiltIn Boolean @default(false) // System templates vs user-created
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([organizationId])
}

model VideoCaption {
  id        String @id @default(cuid())
  projectId String

  // Caption data
  segments Json // TranscriptionSegment[] with word-level timing
  style    Json // CaptionStyle (font, color, position, animation)
  language String @default("en")

  // Export formats cached
  srtContent String? @db.Text
  vttContent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================================
// PLATFORM CREDENTIALS (OAuth App Config)
// ============================================================================

model PlatformCredential {
  id                 String   @id @default(cuid())
  organizationId     String
  platform           Platform
  clientId           String   @db.Text // Encrypted
  clientSecret       String   @db.Text // Encrypted
  webhookVerifyToken String?  @db.Text // Auto-generated token for webhook verification
  isConfigured       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
}

// ============================================================================
// AI SETTINGS (OpenRouter Configuration)
// ============================================================================

model AISettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  apiKey         String   @db.Text // Encrypted OpenRouter API key
  selectedModel  String? // Model ID e.g., "openai/gpt-4o"
  modelName      String? // Display name for UI
  isConfigured   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// THIRD-PARTY INTEGRATION SETTINGS
// ============================================================================

model IntegrationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique

  // Late.dev API Integration (for Google Business Profile posting)
  lateApiKey    String? @db.Text // Encrypted Late API key
  lateProfileId String?          // Late profile ID for OAuth flows

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// GRANULAR PERMISSIONS (RBAC)
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "posts.publish", "analytics.export"
  name        String           // Human-readable name
  category    String           // Grouping: "posts", "analytics", "team", etc.
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([category])
}

model CustomRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id           String @id @default(cuid())
  customRoleId String
  permissionId String

  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionId])
}


// ============================================================================
// SOCIAL ACCOUNTS
// ============================================================================

model SocialAccount {
  id             String    @id @default(cuid())
  organizationId String
  platform       Platform
  platformId     String // Platform's user/page ID
  name           String
  username       String?
  avatar         String?
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiry    DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        PostPlatform[]
  // Engagement & Analytics
  comments     Comment[]
  mentions     Mention[]
  analytics    PlatformAnalytics[]

  @@unique([organizationId, platform, platformId])
  @@index([organizationId])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  META
  TIKTOK
  YOUTUBE
  PINTEREST
  GOOGLE_BUSINESS
  LINKEDIN
  BLUESKY
}

enum PostType {
  FEED // Standard feed post (all platforms)
  REEL // Instagram Reels, TikTok, YouTube Shorts
  STORY // Instagram/Facebook Stories
  CAROUSEL // Multi-image posts (Instagram, LinkedIn, TikTok)
  PIN // Pinterest pins
  VIDEO // Long-form video (YouTube, LinkedIn)
  ARTICLE // LinkedIn articles
  THREAD // Bluesky threads
}

// ============================================================================
// CONTENT
// ============================================================================

model Post {
  id             String     @id @default(cuid())
  organizationId String
  caption        String     @db.Text
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  autoPublish    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // First Comment (Instagram engagement hack)
  firstComment String? @db.Text

  // AI & Analytics
  isAiGenerated   Boolean @default(false) // True if created by AI scheduling
  viralityScore   Float?
  brandVoiceScore Float?

  // External post tracking (synced from platforms)
  isExternal  Boolean   @default(false) // True if synced from platform
  externalId  String?                    // Platform's media/post ID
  externalUrl String?                    // Permalink on platform
  externalThumbnailUrl String?           // Thumbnail URL from platform (for external posts only)
  syncedAt    DateTime?                  // When this was last synced

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pillarId     String?
  pillar       ContentPillar? @relation(fields: [pillarId], references: [id])
  platforms    PostPlatform[]
  media        PostMedia[]
  hashtags     PostHashtag[]
  products     PostProduct[]
  errors       PublishError[]
  // Collaboration
  postComments      PostComment[]
  // ML/Learning (Phase 4)  
  draftInteractions DraftInteraction[]

  @@unique([organizationId, externalId]) // Prevent duplicate imports
  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model PostPlatform {
  id              String     @id @default(cuid())
  postId          String
  socialAccountId String
  platformPostId  String? // ID returned after publishing
  caption         String?    @db.Text // Platform-specific variation
  postType        PostType   @default(FEED)
  callToAction    String? // CTA button type (learn_more, shop_now, etc.)
  customMediaIds  String[] // Platform-specific media override
  firstComment    String?    @db.Text // Platform-specific first comment
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  productTags   ProductTag[]
  analytics     PostAnalytics?

  @@unique([postId, socialAccountId])
}

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  mediaId String
  order   Int    @default(0)
  // User-selected custom thumbnail (frame pick or upload)
  customThumbnailUrl String?

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id])

  @@unique([postId, mediaId])
}

model PostHashtag {
  id        String @id @default(cuid())
  postId    String
  hashtagId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
}

model PostProduct {
  id        String @id @default(cuid())
  postId    String
  productId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([postId, productId])
}

// ============================================================================
// MEDIA LIBRARY
// ============================================================================

model Media {
  id             String   @id @default(cuid())
  organizationId String
  folderId       String?
  filename       String
  mimeType       String
  size           Int // bytes
  width          Int?
  height         Int?
  duration       Float? // seconds for video
  url            String
  thumbnailUrl   String?
  altText        String?
  tags           String[]
  aiTags         String[] // Auto-generated
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  posts        PostMedia[]

  @@index([organizationId, createdAt])
  @@index([folderId])
}

model MediaFolder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  media        Media[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// CONTENT ORGANIZATION
// ============================================================================

model ContentPillar {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#D4A574")
  icon           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        Post[]

  @@unique([organizationId, name])
}

model CaptionTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  caption        String   @db.Text
  hashtags       String[] // Pre-extracted hashtags for quick display
  category       String?  // e.g., "Promotional", "Educational", "CTA"
  usageCount     Int      @default(0)
  // Enhanced template features
  thumbnailUrl String?  // Template preview image
  mediaIds     String[] // Reference to Media items
  platforms    Platform[] // Recommended platforms for this template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Hashtag {
  id         String  @id @default(cuid())
  tag        String  @unique
  isBanned   Boolean @default(false)
  usageCount Int     @default(0)

  posts PostHashtag[]
}

// Saved hashtag collections (groups of hashtags for quick insertion)
model HashtagCollection {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  hashtags       String[] // Array of hashtag strings (without # prefix)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// AI & BRAND VOICE
// ============================================================================

model BrandVoice {
  id             String   @id @default(cuid())
  organizationId String   @unique
  samples        String[] // Past content for training
  toneProfile    Json? // AI-extracted patterns
  guidelines     String?  @db.Text // Brand guide
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// COMMERCE & ATTRIBUTION
// ============================================================================

// Platform Commerce/Shop Connection (for product tagging)
model ShopConnection {
  id             String         @id @default(cuid())
  organizationId String
  platform       Platform
  catalogId      String // Platform's catalog/shop ID
  name           String // Shop display name
  isActive       Boolean        @default(true)
  syncStatus     ShopSyncStatus @default(PENDING)
  lastSyncAt     DateTime?
  lastSyncError  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
  @@index([organizationId])
}

enum ShopSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

// Product tag on a specific post/media (for shoppable posts)
model ProductTag {
  id                String   @id @default(cuid())
  postPlatformId    String
  productId         String? // Link to internal product (optional)
  platformProductId String // Product ID in platform's catalog (required)
  productName       String // Denormalized for display
  productPrice      Float?
  productCurrency   String?
  productImageUrl   String?
  mediaIndex        Int      @default(0) // Which media item (for carousels)
  positionX         Float? // 0-1 percentage from left (null for non-visual tags)
  positionY         Float? // 0-1 percentage from top
  createdAt         DateTime @default(now())

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([postPlatformId])
  @@index([productId])
}

model ProductCatalog {
  id             String        @id @default(cuid())
  organizationId String        @unique
  source         CatalogSource
  externalId     String? // Shopify store ID, etc.
  syncedAt       DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
}

enum CatalogSource {
  SHOPIFY
  WOOCOMMERCE
  MANUAL
}

model Product {
  id          String   @id @default(cuid())
  catalogId   String
  externalId  String // Product ID from source
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  productUrl  String?
  isActive    Boolean  @default(true)
  syncedAt    DateTime @default(now())

  // Platform-specific product IDs for shopping features
  instagramProductId String? // Meta Commerce product ID
  facebookProductId  String? // Meta Commerce product ID (often same as IG)
  pinterestProductId String? // Pinterest catalog product ID
  tiktokProductId    String? // TikTok Shop product ID
  youtubeProductId   String? // YouTube Shopping product ID

  catalog     ProductCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  posts       PostProduct[]
  productTags ProductTag[]

  @@unique([catalogId, externalId])
}

// ============================================================================
// ERROR LOGGING
// ============================================================================

model PublishError {
  id         String   @id @default(cuid())
  postId     String
  platform   Platform
  errorCode  String
  errorRaw   String   @db.Text
  errorHuman String
  suggestion String?
  occurredAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ============================================================================
// ACTIVITY LOG
// ============================================================================

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  userName       String? // Denormalized for display
  action         String // published, scheduled, uploaded, connected, deleted, invited, etc.
  resourceType   String // post, media, account, automation, team, pillar
  resourceId     String?
  resourceName   String
  details        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================================================
// AUTOMATIONS
// ============================================================================

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trigger        String // keyword, new_follower, story_mention, comment
  platform       Platform
  message        String   @db.Text
  isActive       Boolean  @default(true)
  triggered      Int      @default(0)
  delivered      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// COMPETITOR TRACKING
// ============================================================================

model Competitor {
  id             String    @id @default(cuid())
  organizationId String
  platform       Platform
  username       String
  displayName    String?
  avatar         String?
  followers      Int       @default(0)
  followerGrowth Float     @default(0)
  avgEngagement  Float     @default(0)
  postsPerWeek   Float     @default(0)
  isVerified     Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  // Competitor Benchmarking (Phase 3)
  engagementHistory Json?   // { date: string, engagement: number }[]
  shareOfVoice      Float   @default(0) // Calculated percentage vs your brand
  benchmarkScore    Int     @default(0) // 0-100 competitive score

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        CompetitorPost[] // For timing analysis

  @@unique([organizationId, platform, username])
  @@index([organizationId])
}

// ============================================================================
// WEB PUSH NOTIFICATIONS
// ============================================================================

model VapidKeyPair {
  id             String   @id @default(cuid())
  organizationId String   @unique
  publicKey      String   @db.Text
  privateKey     String   @db.Text // Encrypted
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  endpoint       String   @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  userAgent      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([organizationId])
}

model NotificationSettings {
  id             String  @id @default(cuid())
  organizationId String
  userId         String
  postPublished  Boolean @default(true)
  postFailed     Boolean @default(true)
  tokenExpiring  Boolean @default(true)
  weeklyDigest   Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================================
// ENGAGEMENT: COMMENTS
// ============================================================================

model Comment {
  id                String   @id @default(cuid())
  organizationId    String
  socialAccountId   String
  postPlatformId    String? // Link to our published post (if we published it)
  platformPostId    String // Platform's post ID
  platformCommentId String // Platform's comment ID
  authorId          String // Comment author's platform ID
  authorUsername    String
  authorAvatar      String?
  text              String   @db.Text
  sentiment         String? // positive, neutral, negative, question
  isReplied         Boolean  @default(false)
  isHidden          Boolean  @default(false)
  isRead            Boolean  @default(false)
  parentId          String? // For reply threads
  likeCount         Int      @default(0)
  replyCount        Int      @default(0)
  createdAt         DateTime // When comment was created on platform
  syncedAt          DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Comment[]     @relation("CommentReplies")

  @@unique([socialAccountId, platformCommentId])
  @@index([organizationId, createdAt])
  @@index([socialAccountId])
  @@index([postPlatformId])
}

// ============================================================================
// ENGAGEMENT: MENTIONS & TAGS
// ============================================================================

model Mention {
  id              String   @id @default(cuid())
  organizationId  String
  socialAccountId String
  type            String // mention, tag, story_mention, story_reply
  platformPostId  String // The post/story where mention occurred
  authorId        String // Who mentioned us
  authorUsername  String
  authorAvatar    String?
  text            String?  @db.Text // Caption/comment text if available
  mediaUrl        String? // Media thumbnail/URL if available
  isRead          Boolean  @default(false)
  createdAt       DateTime // When mention occurred
  syncedAt        DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId, type])
  @@index([organizationId, isRead])
  @@index([socialAccountId])
}

// ============================================================================
// ANALYTICS: PLATFORM-LEVEL METRICS
// ============================================================================

model PlatformAnalytics {
  id              String   @id @default(cuid())
  organizationId  String
  socialAccountId String
  date            DateTime @db.Date // Day of metrics snapshot
  followers       Int      @default(0)
  followersChange Int      @default(0) // Change from previous day
  following       Int      @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  engagementRate  Float    @default(0) // Percentage
  profileViews    Int      @default(0)
  websiteClicks   Int      @default(0)
  emailClicks     Int      @default(0)
  // Platform-specific metrics stored as JSON
  platformMetrics Json? // { audienceDemographics, topCities, etc. }
  syncedAt        DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@index([organizationId, date])
  @@index([socialAccountId, date])
}

// ============================================================================
// ANALYTICS: POST-LEVEL METRICS
// ============================================================================

model PostAnalytics {
  id                 String   @id @default(cuid())
  postPlatformId     String   @unique
  impressions        Int      @default(0)
  reach              Int      @default(0)
  likes              Int      @default(0)
  comments           Int      @default(0)
  shares             Int      @default(0)
  saves              Int      @default(0)
  clicks             Int      @default(0)
  videoViews         Int? // For video content
  videoWatchTime     Float? // Seconds of watch time
  avgWatchPercentage Float? // Average % of video watched
  engagementRate     Float    @default(0)
  // Platform-specific breakdown
  platformMetrics    Json? // { reachBySource, impressionsByLocation, etc. }
  syncedAt           DateTime @default(now())

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)

  @@index([postPlatformId])
}

// ============================================================================
// UTM TEMPLATES (Composer Enhancement)
// ============================================================================

model UtmTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  source         String   // e.g., "instagram", "facebook"
  medium         String   // e.g., "social", "email"
  campaign       String?  // e.g., "spring_sale"
  content        String?  // e.g., "hero_image"
  term           String?  // e.g., "shoes"
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================================================
// SCHEDULED REPORTS (Analytics)
// ============================================================================

model ScheduledReport {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  schedule       String   // Cron expression e.g., "0 9 * * 1" (Mon 9am)
  recipients     String[] // Email addresses
  config         Json     // ReportConfig { type, dateRange, metrics, etc. }
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([nextRunAt])
}

// ============================================================================
// POST COMMENTS (Collaboration)
// ============================================================================

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies PostCommentReply[]

  @@index([postId])
  @@index([userId])
}

model PostCommentReply {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// ============================================================================
// SMART SCHEDULING (Phase 2 Analytics)
// ============================================================================

/// Learned content timing patterns by content attributes
model ContentTimingPattern {
  id               String   @id @default(cuid())
  organizationId   String
  platform         Platform
  /// Content signature: "short_image_feed", "long_video_reel", etc.
  contentSignature String
  bestDay          Int      // 0-6 (Sunday-Saturday)  
  bestHour         Int      // 0-23
  avgEngagement    Float    @default(0)
  sampleSize       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, contentSignature])
  @@index([organizationId])
}

/// Hashtag performance by time slot
model HashtagTimingPattern {
  id             String   @id @default(cuid())
  organizationId String
  platform       Platform
  hashtag        String   // Normalized lowercase hashtag
  bestDay        Int      // 0-6
  bestHour       Int      // 0-23
  avgEngagement  Float    @default(0)
  sampleSize     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, hashtag])
  @@index([organizationId])
}
// ============================================================================
// COMPETITOR POST TRACKING (Phase 3)
// ============================================================================

/// Tracked competitor posts for timing analysis
model CompetitorPost {
  id           String   @id @default(cuid())
  competitorId String
  platformId   String?  // Post ID from the platform
  postedAt     DateTime
  caption      String?  @db.Text
  mediaType    String?  // image, video, carousel
  engagement   Int      @default(0) // Total engagement (likes + comments)
  likes        Int      @default(0)
  comments     Int      @default(0)
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, platformId])
  @@index([competitorId])
  @@index([postedAt])
}

// ============================================================================
// ML/LEARNING (Phase 4)
// ============================================================================

/// Tracks user interactions with AI-generated drafts for learning
model DraftInteraction {
  id             String          @id @default(cuid())
  organizationId String
  postId         String?         // If draft was converted to a post
  action         DraftAction
  platform       Platform
  postType       PostType        @default(FEED)
  suggestedDay   Int             // 0-6 (original suggestion)
  suggestedHour  Int             // 0-23 (original suggestion)
  finalDay       Int?            // If modified, the final day chosen
  finalHour      Int?            // If modified, the final hour chosen
  reason         String?         // Optional user feedback
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
  @@index([platform, postType])
}

enum DraftAction {
  ACCEPTED   // User accepted the AI draft as-is
  MODIFIED   // User accepted but changed the time
  DISMISSED  // User dismissed the draft
  EXPIRED    // Draft time passed without action
}

/// Stores learned engagement predictions per time slot
model EngagementPrediction {
  id              String   @id @default(cuid())
  organizationId  String
  platform        Platform
  postType        PostType @default(FEED)
  day             Int      // 0-6
  hour            Int      // 0-23
  predictedScore  Float    @default(0) // 0-100 predicted engagement score
  confidence      Float    @default(0) // 0-1 confidence in prediction
  sampleSize      Int      @default(0)
  lastUpdated     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, postType, day, hour])
  @@index([organizationId])
}
